#content.valign-wrapper
  #screen_content{ data: { controller: "screen", screen_target: "content" } }
    - begin
      = render :template => 'homepage/dashboard'
    - rescue

#confirm-modal.info-modal.modal{ data: { controller: "modal" } }
  .modal-content
    %h5.modal-title{ data: { modal_target: "title" } } Confirmation
    #confirm-content.modal-message{ data: { modal_target: "content" } } Are you sure to do this ?
  .modal-footer
    #confirmed-btn.btn.right.modal-close{ data: { action: "click->modal#confirm" } } Yes
    .modal-close.btn-flat.waves-effect No

#error-modal.info-modal.modal{ data: { controller: "modal" } }
  .modal-content
    %h5.modal-title{ data: { modal_target: "title" } } Error
    #error-content.modal-message{ data: { modal_target: "content" } } Something happened.
  .modal-footer
    .modal-close.btn.right OK

#load-modal.info-modal.modal{style: "width: 150px", data: { controller: "modal" } }
  .modal-content
    .modal-message Loading...
