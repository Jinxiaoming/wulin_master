- current_grid = toolbar_items.first ? toolbar_items.first.anchor_tag_options[:id].gsub(/.*_action_on_/, '') : nil
.toolbar-select{hidden: WulinMaster.config.split_button_mode?, 'data-mode': WulinMaster.config.button_mode, data: { controller: "toolbar", toolbar_grid_id_value: current_grid } }
  %ul
    - toolbar_items.each do |item|
      %li.toolbar_item
        = link_to 'javascript:void(0);', item.anchor_tag_options do
          %span.material-icons= item.icon.presence || 'help'
          %span.toolbar-text= item.title
    %li.toolbar_item.more_vert{style:'display: none;'}
      = link_to 'javascript:void(0);', class: 'waves-effect waves-circle dropdown-trigger', id: "#{current_grid}", 'data-target' => "more_vert_#{current_grid}", 'data-alignment' => 'right' do
        %span.material-icons more_vert
    %ul.dropdown-content.collection{:id => "more_vert_#{current_grid}"}
      - toolbar_items.each do |item|
        %li
          = link_to 'javascript:void(0);', **item.anchor_tag_options_without_waves, 'data-id' => item.anchor_tag_options_without_waves[:id], 'data-type' => 'more_vert_item', data: { action: "click->toolbar#proxyClick" }  do
            %span.material-icons
              = item.icon.presence || 'help'
            = item.title
