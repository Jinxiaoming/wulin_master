%fieldset.panel_wrapper
  .panel_btns.center-align{ data: { |
    controller: "inclusion-exclusion", |
    inclusion_exclusion_inclusion_grid_value: panel.inclusion_grid, |
    inclusion_exclusion_exclusion_grid_value: panel.exclusion_grid |
  } }
    - component_names = panel.screen.components.map(&:name)
    - if component_names.index(panel.inclusion_grid) < component_names.index(panel.exclusion_grid)
      %span#add_btn.material-icons.disabled{ data: { action: "click->inclusion-exclusion#include" } } arrow_back
      %span#remove_btn.material-icons.disabled{ data: { action: "click->inclusion-exclusion#exclude" } } arrow_forward
    - else
      %span#add_btn.material-icons.disabled{ data: { action: "click->inclusion-exclusion#include" } } arrow_forward
      %span#remove_btn.material-icons.disabled{ data: { action: "click->inclusion-exclusion#exclude" } } arrow_back
