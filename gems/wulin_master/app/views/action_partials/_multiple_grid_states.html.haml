:ruby
  WulinMaster::GridState.create_default(current_user.id, grid.name)
  states = grid_states_options(current_user.id, grid.name)
  default_states, custom_states = states.partition do |state|
    state[0] == 'default'
  end
  custom_states.sort_by! { |state| state[1] }
  current_state = WulinMaster::GridState.current(current_user.id, grid.name)

.grid-states-switcher{ data: { controller: "grid-states", grid_states_grid_name_value: grid.name, grid_states_current_id_value: current_state.id } }
  %a.dropdown-trigger.btn.grey.lighten-3{"data-target" => "grid_states_#{grid.name}", "data-coverTrigger" => "true", href: "#", id: "current-state-#{grid.name}", data: { action: "click->grid-states#toggleIcon" } }
    %span= current_state.name
    %span{ data: { lucide: 'chevron-down' }, class: 'right' }
  %ul.dropdown-content{id: "grid_states_#{grid.name}"}
    - default_states.each do |option|
      %li
        %a.grid-state-item.grid-state-option-wide{id: "grid-state-#{option[1]}", "data-state-id" => option[1], href: '#!'}= option[0]
      %li.divider
    - custom_states.each do |option|
      %li
        %a.grid-state-item.grid-state-option-wide{id: "grid-state-#{option[1]}", "data-state-id" => option[1], href: '#!'}= option[0]
        %a.edit-icon-container.right{ data: { action: "click->grid-states#openEdit", state_id: option[1], state_name: option[0] } }
          %span{ data: { lucide: 'edit-2' }, class: 'right' }
      %li.divider
    %li
      %a.grid-state-option-parent-wide{id: "add-view-btn-#{grid.name}", data: { action: "click->modal#open" }, href: "#create-state-modal-#{grid.name}"}
        %span{ data: { lucide: 'plus-square' }, class: 'left' }
        ADD VIEW

  .grid-states-modal.modal{id: "create-state-modal-#{grid.name}"}
    .modal-content
      %h5 Create a new view
      .input-field
        %input{type: 'text', id: "view-name-input-create-#{grid.name}", data: { grid_states_target: "createInput", action: "input->grid-states#validateCreate keydown->grid-states#handleCreateKey" }}
        %label{for: "view-name-input-create-#{grid.name}"} View Name
    .modal-footer
      .btn.right.disabled{ data: { grid_states_target: "createBtn", action: "click->grid-states#create" } } Create
      .modal-close.btn-flat Cancel

  #edit-state-modal.grid-states-modal.modal
    .modal-content
      %h5 Edit view
      .input-field
        %input#view-name-input-edit{type: 'text', data: { grid_states_target: "editInput", action: "input->grid-states#validateUpdate keydown->grid-states#handleEditKey" }}
        %label#view-name-label-edit{for: 'view-name-input-edit'} View Name
    .modal-footer
      #update-btn.btn.right.disabled{ data: { grid_states_target: "updateBtn", action: "click->grid-states#update" } } Update
      #delete-btn.btn-flat.red-text.modal-close.right{ data: { action: "click->grid-states#delete" } } Delete
      .modal-close.btn-flat Cancel
