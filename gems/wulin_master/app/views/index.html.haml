- if xhr
  - components.each do |component|
    = render :partial => '/grid', :locals => {:grid => component} if component.grid?
    = render :partial => '/panel', :locals => {:panel => component} if component.panel?
    - break if component.respond_to?(:fill_window?) and component.fill_window?
  :javascript
    window.saveMessage("#{params[:screen]} loaded", 'info');
    const activeMenu = document.querySelector("#menu .active");
    if (activeMenu) {
      const titleText = activeMenu.querySelector('span:not(.material-icons)')?.textContent;
      if (titleText) {
        document.title = `${titleText} | #{WulinMaster.config.app_title}`;
      }
    }
- else
  = render '/header'
  = render '/menu'
  = render '/content'
