%fieldset.panel_wrapper
  .panel_btns.center-align{ data: { |
    controller: "inclusion-exclusion", |
    inclusion_exclusion_inclusion_grid_value: panel.inclusion_grid, |
    inclusion_exclusion_exclusion_grid_value: panel.exclusion_grid |
  } }
    - component_names = panel.screen.components.map(&:name)
    - if component_names.index(panel.inclusion_grid) < component_names.index(panel.exclusion_grid)
      %span#add_btn.disabled{ data: { action: "click->inclusion-exclusion#include", lucide: 'chevron-left' } }
      %span#remove_btn.disabled{ data: { action: "click->inclusion-exclusion#exclude", lucide: 'chevron-right' } }
    - else
      %span#add_btn.disabled{ data: { action: "click->inclusion-exclusion#include", lucide: 'chevron-right' } }
      %span#remove_btn.disabled{ data: { action: "click->inclusion-exclusion#exclude", lucide: 'chevron-left' } }
